# External services are OFF until you supply your own choices and credentials.
VYAPAR_EXTERNAL_APIS_ENABLED=false
VYAPAR_BACKEND_URL=http://127.0.0.1:8000
GROQ_API_KEY=
GROQ_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=

# Public Render service origin, e.g. https://your-service.onrender.com
VITE_BACKEND_URL=

# Optional public browser key. Restrict to app origins and Maps JavaScript API.
# OpenStreetMap remains the default when configured.
VITE_GOOGLE_MAPS_API_KEY=
