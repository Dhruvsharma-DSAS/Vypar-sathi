{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm --prefix vyaparsaathi-city/app ci",
  "buildCommand": "npm --prefix vyaparsaathi-city/app run build",
  "outputDirectory": "vyaparsaathi-city/app/dist",
  "rewrites": [{"source": "/((?!api/).*)", "destination": "/index.html"}],
  "headers": [
    {"source": "/sw.js", "headers": [{"key": "Cache-Control", "value": "no-cache"}]},
    {"source": "/manifest.json", "headers": [{"key": "Cache-Control", "value": "no-cache"}]},
    {"source": "/downloads/(.*)", "headers": [{"key": "Content-Disposition", "value": "attachment"}]}
  ]
}
